# Root env is optional; runtime envs live in backend/.env and frontend/.env.
# Keep this file aligned to backend/src/server.js keys for convenience.
PORT=5000
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-random-secret
SALESFORCE_CLIENT_ID=YOUR_CONNECTED_APP_CONSUMER_KEY
SALESFORCE_CLIENT_SECRET=YOUR_CONNECTED_APP_CONSUMER_SECRET
SALESFORCE_REDIRECT_URI=http://localhost:5000/auth/callback
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_API_VERSION=v61.0
