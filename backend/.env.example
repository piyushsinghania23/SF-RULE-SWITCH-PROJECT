PORT=5000
# Comma-separated allowed frontend origins (local + deployed frontend).
# Wildcards are supported, for example: https://your-frontend-*.vercel.app
FRONTEND_URL=http://localhost:5173
# Where backend should redirect user after OAuth callback.
FRONTEND_REDIRECT_URL=http://localhost:5173
SESSION_SECRET=your-super-secret-session-key-change-this
REDIS_URL=
SALESFORCE_CLIENT_ID=your_connected_app_client_id
SALESFORCE_CLIENT_SECRET=your_connected_app_client_secret
SALESFORCE_REDIRECT_URI=http://localhost:5000/auth/callback
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_API_VERSION=v61.0
